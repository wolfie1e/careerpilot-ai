# ============================================================
# CareerPilot AI — Environment Variables
# Copy this file to .env and fill in your values.
# Never commit .env to version control.
# ============================================================

# ── Database ──────────────────────────────────────────────
DATABASE_URL=postgresql+asyncpg://admin@localhost/careerpilot
DATABASE_URL_SYNC=postgresql://admin@localhost/careerpilot

# ── Auth ──────────────────────────────────────────────────
JWT_SECRET_KEY=your-super-secret-jwt-key-change-this-in-production
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=30

# ── AI Service ────────────────────────────────────────────
AI_API_KEY=your-api-key-here
AI_MODEL=claude-sonnet-4-6
AI_MAX_TOKENS=4096

# ── Embedding Model ───────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384

# ── Voice Transcription ───────────────────────────────────
WHISPER_MODEL=base.en
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8

# ── File Upload ───────────────────────────────────────────
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./uploads
ALLOWED_EXTENSIONS=pdf,docx,txt

# ── Redis (for rate limiting) ─────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Next.js (frontend) ────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
AI_SERVICE_URL=http://localhost:8000
AI_PROXY_TIMEOUT_MS=60000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
NEXTAUTH_SECRET=your-nextauth-secret-change-this
COOKIE_SECRET=your-cookie-secret-change-this

# ── Rate Limiting ─────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=30
RATE_LIMIT_AI_PER_MINUTE=10

# ── Environment ───────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
